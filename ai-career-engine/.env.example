# ==================================================
# AI CAREER ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Add your API key below:

# Primary AI Provider ("nemotron", "gemini", "openai", "ollama")
LLM_PROVIDER=nemotron

# NVIDIA Nemotron Config (NVIDIA NIM API)
# Get your free key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional Fallback Providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Deployment Settings
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# ==================================================
# SKILL-BRIDGE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================

# Primary AI Provider ('nemotron', 'gemini', 'openai', 'ollama')
LLM_PROVIDER=nemotron

# NVIDIA Nemotron Config (NVIDIA NIM Endpoint)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional Alternative Providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Deployment Settings
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
